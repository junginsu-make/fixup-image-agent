# AI Detail Page Studio — apps/web
# Never commit real values. Use .env.local locally and the root-owned
# /etc/detail-page-studio/app.env file on EC2.

# Public app URL (no trailing slash). Used in approval emails.
NEXT_PUBLIC_SITE_URL=https://studio.example.com

# Dedicated Supabase project (Seoul region).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Must never use NEXT_PUBLIC_ prefix or appear in browser code.
SUPABASE_SECRET_KEY=

# 이미지 생성은 fal.ai 를 경유한다. 서버 전용이며 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
FAL_KEY=

# Cloudflare Turnstile site key. The paired secret belongs in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Successful images consume monthly credits. PDP analysis is free but rate-limited.
# 10 is the current starting value; confirm the launch policy before production.
ANALYZE_HOURLY_LIMIT=10

# Operator AI keys. Members never enter or send personal keys.
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=

# Approval-complete email. Configure the same account in Supabase Auth custom SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Existing redesign RAG database (Neon). This is separate from membership Supabase.
DATABASE_URL=

# 로컬 전용. 운영에서는 무시된다.
LOCAL_STORE=
# 로컬 전용. 운영에서는 무시된다.
LOCAL_STORE_ROOT=
# 로컬 전용. 운영에서는 무시된다.
LOCAL_AUTH_BYPASS=
# 로컬 전용. 운영에서는 무시된다.
LOCAL_AUTH_USER_ID=
# 로컬 전용. 운영에서는 무시된다.
LOCAL_AUTH_EMAIL=
