[Unit]
Description=Fixup Image Agent generation execution tick
After=network-online.target fixup-image-agent.service

[Service]
Type=oneshot
User=fixup-agent
Group=fixup-agent
WorkingDirectory=/opt/fixup-image-agent/current
EnvironmentFile=/etc/fixup-image-agent/app.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/fixup-image-agent/current/ops/generation-tick.mjs
TimeoutStartSec=185
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
