# Copy to /etc/fixup-image-agent/app.env, replace every placeholder, then:
# chown root:fixup-agent /etc/fixup-image-agent/app.env
# chmod 640 /etc/fixup-image-agent/app.env
# Never commit or paste the real values into chat.
#
# 여기 적힌 이름은 전부 코드가 실제로 읽는 것이다. 안 읽는 이름을 적어 두면
# 채워 놓고도 안 되는 이유를 찾느라 시간을 쓴다.

# ── 없으면 뜨지 않는다 ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://studio.example.com
# 상세페이지와 같은 Supabase 프로젝트를 쓴다. 회원·사용량 표를 공유한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. NEXT_PUBLIC_ 을 붙이면 브라우저로 새어 나간다.
SUPABASE_SECRET_KEY=

# ── 없으면 아무것도 못 만든다 ─────────────────────────────────────
# 이미지 생성은 전부 fal 을 거친다.
FAL_KEY=
# 다섯 도구 모두의 기획·원고·프롬프트·검수 주 제공자.
# 상세페이지도 2026-09-09 부터 여기를 쓴다 — 전에는 Gemini 를 따로 불렀다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 주 제공자가 실패할 때의 예비, 그리고 검수·조사.
OPENAI_API_KEY=
OPENAI_DRAFT_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_ANALYSIS_MODEL=

# ── 리디자인 ─────────────────────────────────────────────────────
# 리디자인만 아직 Google 을 직접 부른다. 상세페이지는 더 이상 안 쓴다.
GOOGLE_API_KEY=
GOOGLE_READING_MODEL=
# 리디자인이 참고하는 기존 지식 DB(Neon). 회원 Supabase 와 다른 것이다.
DATABASE_URL=
# 지식 API 를 여는 열쇠. 비워 두면 그 API 가 닫힌다.
KNOWLEDGE_ACCESS_KEYS=
KNOWLEDGE_ADMIN_KEY=

# ── 수집 워커 ────────────────────────────────────────────────────
# EC2 는 유튜브 자막 API 에서 IP 로 막힌다. 이 우회가 없으면 유튜브 수집이 안 된다.
APIFY_TOKEN=
APIFY_YOUTUBE_ACTOR=automation-lab~youtube-transcript
# 자막이 아예 없는 영상을 받아쓰는 별도 서비스. 없으면 그 단계만 건너뛴다.
YOUTUBE_STT_SERVICE_URL=
YOUTUBE_STT_SERVICE_SECRET=
# 네이버 뉴스 수집.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 한 사람이 한 시간에 돌릴 수 있는 수집 횟수.
INGEST_MAX_POLLS_PER_USER_PER_HOUR=

# ── 그 밖 ────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ANALYZE_HOURLY_LIMIT=10

# 승인 완료 메일. Supabase Auth 의 custom SMTP 에도 같은 계정을 넣는다.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 광고 규격 내보내기. `1` 일 때만 켜진다 — 없거나 다른 값이면 기능이 통째로
# 없는 쪽이다(`/ad` 404 · 만들기 화면에 광고 모드 없음).
AD_EXPORT=

# ── 여기에 넣지 않는다 ───────────────────────────────────────────
# LOCAL_STORE · LOCAL_STORE_ROOT · LOCAL_AUTH_BYPASS · LOCAL_AUTH_USER_ID
# · LOCAL_AUTH_EMAIL · LOCAL_FAKE_AI_SCENARIO
#
# 로컬 확인용이다. 코드가 NODE_ENV=production 에서는 이 값들을 무시하므로
# 넣어도 켜지지는 않는다. 다만 켜졌다고 착각하게 만든다 — 두지 않는다.
