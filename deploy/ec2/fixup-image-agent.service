[Unit]
Description=Fixup Image Agent web (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fixup-agent
Group=fixup-agent
WorkingDirectory=/opt/fixup-image-agent/current/apps/web
EnvironmentFile=/etc/fixup-image-agent/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
