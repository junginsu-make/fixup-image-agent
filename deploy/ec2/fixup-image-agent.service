[Unit]
Description=Fixup Image Agent web (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fixup-agent
Group=fixup-agent
WorkingDirectory=/opt/fixup-image-agent/current/apps/web
EnvironmentFile=/etc/fixup-image-agent/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
# 카드 글자를 서버에서 그린다. 동봉한 서체를 fontconfig 가 보게 한다.
Environment=FONTCONFIG_FILE=/opt/fixup-image-agent/current/apps/web/assets/fonts/fonts.conf
# 쓸 수 있는 캐시가 없으면 매번 폰트를 다시 훑는다. 카드 10장이면 열 번이다.
Environment=XDG_CACHE_HOME=/var/lib/fixup-image-agent/cache
# 위 캐시 자리를 systemd 가 만들고 소유자를 맞춘다. 설치 스크립트에 mkdir 을
# 더하면 그 스크립트를 다시 안 돌린 서버에서만 조용히 느려진다.
StateDirectory=fixup-image-agent
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
