{{DOMAIN}} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# 정적 파일과 API를 나누지 않는다. 전체 도메인을 단일 Next.js upstream으로
	# 보내 경로별 프록시가 정적 자산을 가리는 사고를 방지한다.
	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/detail-page-studio.access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
